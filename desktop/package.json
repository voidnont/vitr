{
  "name": "vitr",
  "private": true,
  "version": "0.1.0",
  "description": "vitr standalone UI for Windows",
  "author": "Blood",
  "scripts": {
    "test": "node -e \"console.log('vitr standalone UI')\"",
    "check": "npm test",
    "icons": "tauri icon web/vitr-icon.png --output src-tauri/icons",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles msi,nsis",
    "tauri:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File platforms/windows/generate-installer-art.ps1 -Version 0.1.0 && tauri build --bundles msi,nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  },
  "engines": {
    "node": ">=20"
  }
}
