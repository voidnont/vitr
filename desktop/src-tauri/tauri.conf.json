{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vitr",
  "version": "0.1.0",
  "identifier": "app.vitr.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "vitr",
        "width": 1180,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "shadow": true,
        "backgroundColor": "#070b12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: https:; connect-src 'self' ipc: http://ipc.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg"
    ],
    "publisher": "blood",
    "category": "Music",
    "shortDescription": "vitr Music Player",
    "longDescription": "vitr brings the native vitr music experience to Windows, Linux and macOS.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/vitr-nsis-header.bmp",
        "uninstallerHeaderImage": "installer/vitr-nsis-header.bmp",
        "sidebarImage": "installer/vitr-nsis-sidebar.bmp",
        "installMode": "currentUser",
        "startMenuFolder": "Vitr"
      },
      "wix": {
        "bannerPath": "installer/vitr-wix-banner.bmp",
        "dialogImagePath": "installer/vitr-wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgRTA0QzFFQzE3MDNCODU3NwpSV1IzaFR0d3dSNU00T2ZiY3JObVQ1UitTN3BveHVJb2hyUStyRXh4cnNoMGRwdXdiU1FsdXFPLwo=",
      "endpoints": [
        "https://github.com/voidnont/vitr/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
