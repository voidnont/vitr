{
  "name": "vitr-web-suite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "node scripts/validate.mjs",
    "adapt:sources": "node scripts/adapt-sources.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "build": "vite build",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ci": "playwright test",
    "preview": "vite preview",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:test": "npm --prefix desktop test",
    "desktop:check": "npm --prefix desktop run check",
    "desktop:dev": "npm --prefix desktop run tauri:dev",
    "desktop:build": "npm --prefix desktop run tauri:build",
    "desktop:build:windows": "npm --prefix desktop run tauri:build:windows",
    "desktop:build:linux": "npm --prefix desktop run tauri:build:linux",
    "desktop:build:macos": "npm --prefix desktop run tauri:build:macos",
    "check:all": "npm run check && npm run test:unit && npm run desktop:check"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.5"
  },
  "license": "SEE LICENSE IN LICENSE"
}
